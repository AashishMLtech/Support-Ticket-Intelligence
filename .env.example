# LLM provider. This project currently supports Groq for natural-language query handling.
LLM_PROVIDER=groq

# Free Groq key from https://console.groq.com. Leave blank to run health, schema, UI, and anomalies only.
GROQ_API_KEY=your_groq_api_key_here

# Groq model used for structured query planning.
GROQ_MODEL=openai/gpt-oss-120b

# Local CSV path.
DATA_PATH=data/support_tickets.csv

# Optional fixed as-of timestamp. Blank means max(created_at) from the dataset.
AS_OF_DATE=

# LLM request timeout in seconds.
LLM_TIMEOUT_SECONDS=20

# Maximum rows returned from query-style endpoints.
MAX_RESULT_ROWS=100
